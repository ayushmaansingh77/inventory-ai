FLASK_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-too
DATABASE_URL=postgresql://postgres:password@localhost:5432/inventory_db
MAIL_SERVER=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
# Sender for all outgoing mail (verification, low-stock alerts). Mailtrap
# sandbox accepts any value; a real provider (e.g. Gmail) usually requires
# this to match MAIL_USERNAME.
MAIL_DEFAULT_SENDER=noreply@stockmind.com

# --- To switch from Mailtrap sandbox to real Gmail SMTP delivery ---
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your-address@gmail.com
# MAIL_PASSWORD=<a Gmail App Password, not your normal password>
# MAIL_DEFAULT_SENDER=your-address@gmail.com